{
  "manifest_version": 3,
  "name": "BOSS直聘海投助手",
  "version": "1.1.9",
  "description": "在 BOSS 职位页按规则与 AI 筛选岗位，使用官方默认招呼，管理每日额度。独立扩展，无需油猴。",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://www.zhipin.cn/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.zhipin.com/*", "https://www.zhipin.cn/*"],
    "js": ["platform.js", "helper.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "action": {
    "default_title": "BOSS直聘海投助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png", "32": "icons/icon32.png",
      "48": "icons/icon48.png", "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png", "32": "icons/icon32.png",
    "48": "icons/icon48.png", "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
